{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["api", "src/utils/outlineParser.ts", "src/utils/habitInsightStats.ts", "src/utils/habits.ts", "src/utils/habitStats.ts", "src/types.ts"]
}
