VITE_APP_NAME=Anywhere Path

# Supabase — required for accounts and cloud sync. Without these the app
# still runs, but the auth screens show a setup notice instead of a form.
# See supabase/SETUP.md for how to get these values and where to put them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — only needed for the "Generate with AI" roadmap button, which
# calls /api/generate (a Vercel serverless function — these never reach the
# browser). Without them the button shows a friendly "not set up" message;
# every other feature works the same either way. See supabase/SETUP.md.
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
#
# The function also needs server-side Supabase access (to verify who's
# calling it, and to rate-limit per user) — SUPABASE_URL and
# SUPABASE_ANON_KEY can reuse the VITE_SUPABASE_* values above, but
# SUPABASE_SERVICE_ROLE_KEY has no safe client-side equivalent and must be
# set separately. Never prefix this one with VITE_ — that would ship it to
# every visitor's browser.
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — shows a "Still need help?" contact link on the Help page when
# set. Leave unset to hide that section entirely.
# VITE_SUPPORT_EMAIL=

# Optional — push reminders (Settings > Notifications > "Push reminders").
# Generate the key pair with `npx web-push generate-vapid-keys` — never
# commit the private key. See supabase/SETUP.md section 8.
#
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# CRON_SECRET=
